<launch>
  <arg name="model"
    default="$(find-pkg-share choreonoid_ros2_mobile_robot_tutorial)/model/mobile_robot_sensors_ros2_control.urdf"/>

  <!-- choreonoid -->
  <node pkg="choreonoid_ros" exec="choreonoid"
    args="--start-simulation $(find-pkg-share choreonoid_ros2_mobile_robot_tutorial)/project/mobile_robot_drive_ros2_control.cnoid">
    <param from="$(find-pkg-share choreonoid_ros2_mobile_robot_tutorial)/config/ros2_controllers.yaml"/>
    <remap from="base_controller/cmd_vel" to="/cmd_vel"/>
  </node>

  <!-- robot state publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var model)')"/>
    <param name="use_sim_time" value="true" />
  </node>

  <!-- controller spawner -->
  <node pkg="controller_manager" exec="spawner" name="controller_spawner" args="joint_state_broadcaster base_controller joint_trajectory_controller">
    <param name="use_sim_time" value="true" />
  </node>

  <node pkg="rqt_gui" exec="rqt_gui" name="rqt" args="--perspective-file $(find-pkg-share choreonoid_ros2_mobile_robot_tutorial)/config/control.perspective"/>
</launch>
